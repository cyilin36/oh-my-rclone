# ==============================================================
# oh-my-rclone 环境变量示例
# 复制为 .env 后按需修改。
#
# ⚠️ 重要：宿主机所挂载的目录一律填写【绝对路径】，
#    避免相对路径在不同工作目录下解析不一致（尤其配合 docker compose）。
#    每个源目录需在 docker-compose 中挂载到容器内 /data 下对应子目录。
# ==============================================================

TZ=Asia/Shanghai

# ---- cron 定时（dcron 语法，不填默认每天 03:00）----
CRON_SCHEDULE="0 3 * * *"

# ---- 挂载：宿主机绝对路径 ----
# reflink 快照暂存区，映射到容器 /tmp（建议绝对路径，并建议列入同步排除项）
TMP_DIR=/var/lib/oh-my-rclone/tmp
# 宿主机 docker.sock（docker 适配功能使用）
DOCKER_API=/var/run/docker.sock

# 各任务的源目录（容器内统一挂到 /data 下子目录，见 compose 模板）。
# 单源时填一个父目录即可；多源（多条同步备份）时，请在 docker-compose.yml 的
# volumes 中把每个宿主机【绝对路径】源分别挂到 /data/xxx 下唯一子目录，
# 并让 jobs.conf 的 src 填写对应的容器内路径（如 /data/postgres）。
DATA_SRC_DIR=/path/to/source/parent

# ==============================================================
# 特别功能 1：reflink 快照
# 把源文件以 reflink 方式复制一份到容器 /tmp 暂存，再上传该副本，避免源被持续写入导致反复上传。
# 上传完成后删除副本释放磁盘。
# ==============================================================
REFLINK_ENABLE=true            # true/false，默认 true
REFLINK_STRICT=false           # true=当文件系统不支持 reflink 时任务报错（默认 false 自动降级为普通复制）

# ==============================================================
# 特别功能 2：docker 适配（针对宿主机上的业务容器，尤其数据库挂载目录）
# 关闭 reflink 时：冻结命中容器 → 全程上传 → 解冻。
# 开启 reflink 时：冻结命中容器 → 完成快照 → 立即解冻 → 后台上传快照（业务容器尽快恢复）。
# 本容器（oh-my-rclone）永远被排除，绝不冻结自身 → 杜绝死循环。
# ==============================================================
DOCKER_ADAPT_ENABLE=false      # true/false，默认 false
DOCKER_MODE=whitelist           # whitelist=只处理下列容器；blacklist=下列容器之外的运行中容器被处理
DOCKER_CONTAINERS=postgres,mysql   # 容器记录表（逗号分隔，容器名）

# ==============================================================
# 特别功能 3：同步目录排除项
# 排除规则文件（文件/文件夹/类型；支持“某目录下某类型全排除”，见 excludes.conf.example）
# ==============================================================
EXCLUDE_CONF=/etc/oh-my-rclone/conf/excludes.conf

# ==============================================================
# 特别功能 4：webhook 通知（兼容 astrbot_plugin_push_lite）
# 需要报告：同步成败、上传数据量、失败文件、失败文件大小、开始/结束/总耗时。
# ==============================================================
WEBHOOK_ENABLE=false           # true/false，默认 false
WEBHOOK_SUCCESS_ONLY=false     # true=仅成功时通知；false=成败都通知
# astrbot_plugin_push_lite 的推送 API 地址与 token（URL/鉴权字段可配，见 README）
ASTROBOT_PUSH_URL=https://your-astrbot.example.com/api/push
ASTROBOT_PUSH_TOKEN=your_token
FAIL_LIST_MAX=50               # 失败清单最大条数，防止 webhook 过长

# ==============================================================
# sftp 远程自动生成（仅当 conf/rclone.conf 未定义远程时才会据此生成 [backup-sftp]）
# 优先级：conf/rclone.conf 现有远程 > 以下 SSH_* 自动生成
# ==============================================================
RCLONE_ALIAS=backup-sftp
SSH_HOST=192.168.1.50
SSH_USER=backupuser
SSH_PASS=your_sftp_password     # 与密钥二选一
# SSH_PORT=22
# SSH_KEY_FILE=/keys/id_ed25519  # 私钥（容器内路径）；需在 compose 中挂载