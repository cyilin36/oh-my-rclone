# ==============================================================
# oh-my-rclone 环境变量（.env）—— 全局默认层
#
# 职责：提供各项【默认值】—— 默认远端服务器、功能开关默认、默认定时、webhook 全局默认。
# 任务细则（src/dest/排除/任务级覆盖）在 conf/config.toml 中配置，这里不掺和。
# 优先级：任务块 > config.toml 顶部(可选) > 本文件默认。
#
# 复制为 .env 后按需修改（含密码/token，勿提交，已在 .gitignore）。
# ⚠️ 宿主机挂载目录在 docker-compose.yml 中配置（不进 .env）。
# ==============================================================

TZ=Asia/Shanghai

# ===== 默认远端服务器（任务没单独写就用它）=====
REMOTE_HOST=192.168.1.50
REMOTE_USER=backupuser
REMOTE_PASS=your_password        # 明文即可，启动时自动 rclone obscure 加密写入 rclone.conf
REMOTE_PORT=22
# REMOTE_KEY_FILE=/keys/id_ed25519   # 私钥（容器内路径）；需在 compose 中挂载

# ===== 各项功能开关（默认值，任务可在 config.toml 覆盖）=====
REFLINK_ENABLE=true              # reflink 快照（默认 true）
REFLINK_STRICT=false             # true=文件系统不支持 reflink 时任务报错
DOCKER_ADAPT_ENABLE=false        # docker 适配（默认 false）
DOCKER_MODE=whitelist            # whitelist | blacklist
DOCKER_CONTAINERS=postgres,mysql # 容器记录表（逗号分隔，容器名）

# ---- stop/start（可选，替代 pause/unpause）----
# 开启 docker 适配时，列出的容器不做 pause/unpause，改为：备份前先 docker stop，备份后 docker start。
# 逗号分隔容器名；空 = 不启用。仅全局配置，任务块不支持覆盖。
# ⚠️ 建议这些容器所在任务开启 reflink：只停做快照那一下（秒级~分钟级）；reflink 关闭时容器整个上传期间都是停的。
DOCKER_STOP_CONTAINERS=          # 逗号分隔，例如 myapp
DOCKER_STOP_TIMEOUT=30           # docker stop 等容器退出的秒数，超时会被强杀
# DOCKER_START_RETRY=5           # docker start 失败重试次数
# DOCKER_START_WAIT=2            # docker start 重试间隔（秒）
FAIL_LIST_MAX=50                 # 失败清单最大条数，防止 webhook 过长

# ===== webhook 全局默认（任务可在 config.toml 覆盖）=====
WEBHOOK_ENABLE=false             # 默认不开；某任务开了才算（任务级 webhook）
WEBHOOK_SUCCESS_ONLY=false       # true=仅成功时通知
# astrbot_plugin_push_lite：URL 为插件 API 地址（如 http://IP:端口），
# token 为该插件配置的 API 令牌；umo 为目标会话标识（在 astrbot 用 /sid 查询，必填）
ASTROBOT_PUSH_URL=https://your-astrbot.example.com:端口
ASTROBOT_PUSH_TOKEN=your_token
ASTROBOT_PUSH_UMO=your_umo_会话标识

# ===== 默认定时 =====
CRON_SCHEDULE="0 3 * * *"        # dcron 语法

# ===== 日志与自动清理（默认值即可，按需覆盖）=====
# 日志统一存放于容器内 $LOG_DIR（默认 /var/lib/oh-my-rclone/logs）。
# 如需跨容器重建持久保留，请在 docker-compose.yml 挂载宿主目录到 $LOG_DIR（见 compose 示例注释）。
# LOG_DIR=/var/lib/oh-my-rclone/logs     # 日志根目录（容器内路径）
LOG_RETENTION_DAYS=7                      # 日志保留天数（默认 7；0=关闭按时长清理）
LOG_CLEANUP_ENABLE=true                   # 自动清理总开关（轮转 + 按时长删除）
LOG_MAX_SIZE=20M                          # backup.log 超过此大小自动轮转（B/KB/MB/GB/KiB/MiB/GiB/K/M/G/T）
# LOG_ROTATE_KEEP=3                       # 轮转保留的旧 backup.log 份数
# LOG_CLEANUP_SCHEDULE="30 4 * * *"       # 每日日志清理 cron 时间（与备份错开）

# ===== 全局排除（可选，所有任务生效，任务级 exclude 再叠加）=====
# 分号分隔，语法见 config.toml.example / README
# EXCLUDE_GLOBAL="ext=.log; dir=node_modules/"