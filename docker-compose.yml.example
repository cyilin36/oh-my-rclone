# docker-compose.yml.example - oh-my-rclone 编排示例
#
# ⚠️ 使用前：
#   - 复制 .env.example 为 .env（默认远端/开关/定时/webhook 默认值）
#   - 复制 conf/config.toml.example 为 conf/config.toml（每个任务一个块）
#   - 宿主机【挂载】全部在这里配置（绝对路径），.env 不承载路径
#
# 用法：
#   docker compose up -d --build        # 构建并启动
#   docker compose exec oh-my-rclone /scripts/run-backup.sh          # 立即触发一次备份
#   docker compose exec oh-my-rclone /scripts/run-backup.sh FORCE_DRY_RUN=1  # 预检(dry-run)

services:
  oh-my-rclone:
    build: .
    # 也可替换为已构建镜像名
    # image: local/oh-my-rclone:latest
    container_name: oh-my-rclone
    restart: unless-stopped
    hostname: oh-my-rclone
    env_file: .env                  # 注入全局默认（默认远端/开关/定时/webhook）
    environment:
      - TZ=${TZ}
      - CONTAINER_NAME=oh-my-rclone
    volumes:
      # ---- 源数据目录（宿主机【绝对路径】挂载）----
      # 每个源挂到容器 /data 下唯一子目录；config.toml 任务的 src 填对应的容器内路径。
      # 例：postgres 源 → /data/postgres；docs 源 → /data/docs
      # - /path/to/postgres_data:/data/postgres:ro
      # - /path/to/docs:/data/docs:ro

      # ---- reflink 暂存区：映射到容器 /tmp ----
      # - /var/lib/oh-my-rclone/tmp:/tmp

      # ---- 宿主机 Docker socket（docker 适配功能必需）----
      # 若 DOCKER_ADAPT_ENABLE=false 可移除下面这行。
      # - /var/run/docker.sock:/var/run/docker.sock:ro

      # ---- 配置文件（config.toml + 可选 rclone.conf / 密钥）----
      - ./conf:/etc/oh-my-rclone/conf:ro

      # 如需 sftp 密钥登录，挂载私钥（按需取消注释）：
      # - /path/to/id_ed25519:/keys/id_ed25519:ro

    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"